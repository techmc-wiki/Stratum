# StratumMC Docker Compose Configuration
# Controller runs on the host; agents run in containers.
# Start controller on host first: stratum-controller serve --listen 0.0.0.0:8080

# Agent authentication token (shared secret)
# Leave empty for no auth (development only)
AGENT_TOKEN=

# HTTP proxy for server jar downloads (optional)
# e.g. HTTP_PROXY=http://127.0.0.1:10808
HTTP_PROXY=

# Lucy workspace directory (set "none" to disable Lucy)
# e.g. LUCY_WORKSPACE=/runtime/lucy
LUCY_WORKSPACE=none
