{
  "runtime_profiles": [
    {
      "id": "mcdr-fabric-1.17",
      "name": "MCDR + Fabric 1.17 Terminal",
      "runtime_type": "mcdr-python",
      "command_argv": ["mcdreforged", "start"],
      "working_dir": "",
      "stop_strategy": "stdin",
      "stop_stdin_command": "!!MCDR stop",
      "graceful_stop_timeout": "60s",
      "force_kill_timeout": "15s",
      "log_mode": "combined",
      "enabled": true,
      "notes": "MCDR child runtime for Fabric 1.17. Agent supervises MCDR; MCDR starts Minecraft via config.yml start_command.",
      "readiness_check": {
        "type": "log-pattern",
        "pattern": "Done (",
        "timeout": "180s"
      }
    }
  ]
}
